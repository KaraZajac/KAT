# librtlsdr's FC0012 driver: init, tuning (with the VCO voltage read back as 0x20, 0x00 and
# 0x3f), gains, and the frequencies the PLL cannot reach.
tuner fc0012
reg c6 1d ff
init
ovr c6 0e 00 20
freq 22000000
freq 37083999
freq 37084000
freq 50000000
freq 55625000
freq 74167000
freq 100000000
freq 111250000
freq 148334000
freq 200000000
freq 222500000
freq 296667000
freq 299999999
freq 300000000
freq 300000001
freq 444999999
freq 445000000
freq 593333999
freq 593334000
freq 948600000
freq 299750000
freq 303625000
freq 309750000
freq 314750000
freq 317750000
freq 389750000
freq 417750000
freq 433170000
freq 433670000
freq 434170000
freq 868100000
freq 914750000
ovr c6 0e 00 00
freq 100000000
freq 433670000
freq 868100000
freq 950000000
ovr c6 0e 00 3f
freq 100000000
freq 433670000
freq 868100000
freq 950000000
freq 1000000000
freq 1500000000
gain -100
gain -41
gain -40
gain -39
gain 0
gain 70
gain 71
gain 72
gain 100
gain 178
gain 179
gain 180
gain 191
gain 192
gain 300
bw 2000000
xtal 28801000
freq 433670000
exit
